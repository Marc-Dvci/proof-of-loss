# Every variable the code reads. The offline checks and the replay need none of them; only a live rehearsal does.
# llama.cpp server binary, and the Gemma 4 26B-A4B GGUF with its vision projector.
LLAMA_SERVER=llama-server
POL_VISION_MODEL=gemma-4-26B-A4B-it.gguf
POL_VISION_MMPROJ=mmproj-F16.gguf
# Only for the two-model profile of tools/rehearsal_queue.py and harness/servers.sh.
POL_TEXT_MODEL=
POL_VISION_NGL=24
POL_VISION_CTX=8192
# Default server URL of harness/llm.py.
POL_LLM_URL=http://127.0.0.1:8099
# Where the UGREEN Skill Developer Package sits. Default: next to this folder.
POL_KIT_DIR=../uliya-skill-kit-0.7.3
