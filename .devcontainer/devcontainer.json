{
  "name": "Proof of Loss",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && python tools/fetch_kit.py",
  "postAttachCommand": "python tools/replay.py A1-burglary",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "examples/A1-burglary/CLAIM-DOSSIER.md"]
    }
  }
}
