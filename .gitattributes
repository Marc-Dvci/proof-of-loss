# Text files are stored with LF, whatever machine they were last saved on. Scripts run on Linux too.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# The synthetic archive is hashed byte for byte: git must never touch its line endings.
testdata/archive/** -text
*.pdf binary
*.jpg binary
*.JPG binary
*.png binary

# Keep the languages bar honest: figure sources, recorded runs and test data are not the project's code.
docs/figures/src/** linguist-generated
evidence/** linguist-generated
examples/** linguist-documentation
testdata/spec/** linguist-generated
testdata/index/** linguist-generated
testdata/archive/** linguist-generated
